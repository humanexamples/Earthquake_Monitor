# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=raw-seismic-events

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=earthquake
MONGODB_COLLECTION=silver_events
KAFKA_GROUP_ID=silver-layer

# ── MinIO / S3 (Bronze + Silver + Gold) ─────────────────────────────────────
# MINIO_ROOT_* = MinIO server credentials (used by the minio container itself)
# S3_* = client-side credentials used by all services and the test runner
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eq-monitor

# ── Flink ───────────────────────────────────────────────────────────────────
FLINK_JOBMANAGER_URL=http://flink-jobmanager:8081

# ── Spark ───────────────────────────────────────────────────────────────────
# SPARK_MASTER is used in the files in ./services/spark-jobs to connect to the Spark master.
SPARK_MASTER=spark://spark-master:7077
# SPARK_WORKER_MEMORY and SPARK_WORKER_CORES are used in the Dockerfile for the Spark worker 
# to configure its resources.
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ── PostgreSQL DWH ──────────────────────────────────────────────────────────
# POSTGRES_DWH_* = used by docker-compose.yml for container initialisation

# DWH_* = used by services and tests at runtime
POSTGRES_DWH_DB=earthquake
POSTGRES_DWH_USER=eq_user
POSTGRES_DWH_PASSWORD=eq_password_change_me

# DWH_HOST, DWH_PORT, DWH_DB, DWH_USER, and DWH_PASSWORD are used 
# by all services to connect to the Gold DWH PostgreSQL database.   
DWH_HOST=postgres-dwh
DWH_PORT=5432
DWH_DB=earthquake
DWH_USER=eq_user
DWH_PASSWORD=eq_password_change_me

# ── PostgreSQL Airflow metadata DB ──────────────────────────────────────────
# POSTGRES_AIRFLOW_* = used by docker-compose.yml for container initialisation
# AIRFLOW_DB_* = used by Airflow services at runtime
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow_password_change_me
AIRFLOW_DB_HOST=postgres-airflow
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_password_change_me

# ── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow_password_change_me@postgres-airflow:5432/airflow
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW__WEBSERVER__SECRET_KEY=eq-monitor-webserver-secret-dev
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin_password_change_me
AIRFLOW_ADMIN_EMAIL=admin@eq-monitor.local

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_password_change_me
