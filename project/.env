# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=raw-seismic-events
KAFKA_GROUP_ID=silver-layer
SILVER_KAFKA_TOPIC=silver-processed-events
GOLD_KAFKA_GROUP_ID=gold-layer

# ── MinIO / S3 (Bronze + Silver) ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eq-monitor

# ── PostgreSQL (Gold DWH) ────────────────────────────────────────────────────
POSTGRES_GOLD_HOST=postgres_gold
POSTGRES_GOLD_PORT=5432
POSTGRES_GOLD_DB=earthquake_gold
POSTGRES_GOLD_USER=gold_user
POSTGRES_GOLD_PASSWORD=gold_password
