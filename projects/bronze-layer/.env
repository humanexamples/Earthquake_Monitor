# =============================================================================
# .env.dev — Bronze Layer only
# EMSC WebSocket → Kafka → MongoDB + MinIO bronze/
# NEVER commit this file. Only .env.example is committed.
# =============================================================================

# ── EMSC WebSocket ────────────────────────────────────────────────────────────
EMSC_WS_URL=wss://www.seismicportal.eu/standing_order/websocket

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=raw-seismic-events

# ── MongoDB (operational raw store) ──────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=earthquake
MONGODB_COLLECTION=raw_events
MONGODB_TTL_DAYS=30

# ── MinIO / S3 (Bronze layer) ─────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eq-monitor
